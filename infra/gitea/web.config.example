<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS + ARR로 Gitea와 플랫폼을 **같은 도메인의 서브패스**로 내보내는 사이트의
  web.config 예시 (Caddyfile.example의 IIS판). 포트를 하나(80/443)만 열 수 있는
  환경 기준이다.

  놓는 위치: 공개 도메인 사이트의 물리 경로 루트 (예: C:\inetpub\paas\web.config).

  ─ 이 파일로 되는 것 / 안 되는 것 ────────────────────────────────────────────
  URL Rewrite 규칙은 web.config에 들어간다. 하지만 **ARR의 프록시 설정은 서버
  레벨(applicationHost.config)**이라 여기 적으면 500.19로 죽는다. 아래 세 개는
  appcmd로 한 번 켠다(플랫폼이 만드는 사이트에는 앞의 둘이 자동 적용되지만,
  사람이 직접 만든 /gitea·/paas 규칙에는 적용되지 않는다):

    %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy ^
      /enabled:True /commit:apphost
    %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy ^
      /passThroughAuthorizationHeader:True /commit:apphost
    %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy ^
      /reverseRewriteHostInResponseHeaders:False /commit:apphost

  첫째를 빼면 규칙은 매칭되는데 전달이 안 돼 전 경로가 502다. 둘째를 빼면
  Authorization 헤더가 떨어져 Bearer/OIDC 인증이 깨진다. 셋째는 아래 "루프백"
  주석 참고 — git push의 브라우저 로그인이 여기 걸린다.

  ─ 플랫폼의 자동 생성과 함께 쓸 때 ───────────────────────────────────────────
  PAAS_PROXY_BACKEND=iis면 플랫폼이 배포할 때마다 이 파일의 "paas:managed" 주석
  마커 사이에 자기 규칙을 끼워 넣는다(services/proxy/iis_proxy.py). 마커 **밖**은
  건드리지 않으므로 아래 규칙은 그대로 살아남는다. 마커 안에는 직접 쓰지 말 것 —
  다음 배포 때 덮어써진다.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          /gitea — 접두어를 **벗겨서** 넘긴다(타겟에 /gitea를 다시 붙이지 않는다).
          Gitea는 모든 라우트를 "/" 에 마운트하고 서브패스를 벗기는 미들웨어가
          없다(routers/init.go의 NormalRoutes) — 서브패스는 ROOT_URL이 **링크를
          만들 때만** 쓰고, 실제 요청에서 벗기는 일은 리버스 프록시 몫이다.
          그래서 짝은 이렇게 맞는다:
            [server] ROOT_URL = https://<도메인>/gitea/   ← Gitea가 링크를 /gitea/…로 생성
            프록시                                        ← /gitea를 벗기고 전달
          타겟에 /gitea를 남기면 Gitea가 /gitea/… 라우트를 몰라 전부 404가 된다.
          (예외: [server] USE_SUB_URL_PATH = true 로 두면 Gitea가 서브패스를 직접
          처리하므로 그때는 벗기지 않는다. 기본값은 false다.)

          호스트를 127.0.0.1이 아니라 localhost로 둔 것은 의도한 것이다 —
          ARR의 응답 헤더 역방향 재작성이 백엔드와 같은 호스트 이름을 공개
          도메인으로 바꿔치기하는데, git push의 OAuth 콜백이 바로
          http://127.0.0.1:<임의포트>/ 라서 이름이 겹치면 개발자 PC로 가야 할
          리다이렉트가 서버로 되돌아온다(README "승인했는데 127.0.0.1로
          넘어가지 않는다"). 위 appcmd로 역방향 재작성을 껐다면 127.0.0.1로 둬도
          된다.

          주의 — Windows에서 localhost는 ::1로 먼저 풀린다. Gitea가
          [server] HTTP_ADDR = 127.0.0.1 로만 듣고 있으면 이 타겟은 502가 난다.
          그때는 HTTP_ADDR을 비우거나(전 인터페이스) 머신 이름을 쓴다.
        -->
        <rule name="gitea-root-slash" stopProcessing="true">
          <match url="^gitea$" />
          <action type="Redirect" url="/gitea/" redirectType="Permanent" />
        </rule>
        <rule name="gitea" stopProcessing="true">
          <match url="^gitea/(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>

        <!--
          /paas — 플랫폼 자신. 이 규칙이 있으면 PAAS_OIDC_PROVIDER_BACKCHANNEL_URL
          우회가 필요 없다(공개 도메인으로 /paas가 들어오므로).

          여기는 위 Gitea와 **반대로 접두어를 벗기지 않는다.** 플랫폼은 라우터를
          /paas 아래에 직접 등록하기 때문이다(app/main.py의 PAAS_PREFIX). 벗기면
          전부 404다. 둘의 규칙이 달라 보이는 건 오타가 아니다.

          포트는 플랫폼 백엔드다(uvicorn, 기본 7000). vite dev server(5173)를
          가리키면 /paas/* API가 전부 404가 되고, OIDC 콜백도 같이 죽는다.

          appendQueryString는 기본값(true)에 의존한다 — 명시적으로 false로 두면
          OIDC 콜백의 ?code=...&state=...가 통째로 사라져, 로그인은 되는데 그
          다음이 조용히 끊긴다.
        -->
        <rule name="paas" stopProcessing="true">
          <match url="^paas/(.*)" />
          <action type="Rewrite" url="http://localhost:7000/paas/{R:1}" />
        </rule>

        <!--
          /console — 플랫폼 콘솔(정적). 백엔드와 같은 프로세스가 서빙한다.
        -->
        <rule name="paas-console" stopProcessing="true">
          <match url="^console/?(.*)" />
          <action type="Rewrite" url="http://localhost:7000/console/{R:1}" />
        </rule>

        <!-- 플랫폼이 배포 규칙을 끼워 넣는 자리. 직접 쓰지 말 것. -->
        <!-- paas:managed:begin -->
        <!-- paas:managed:end -->
      </rules>

      <!--
        아웃바운드 규칙(outboundRules)이 없다면 여기서 끝이다. 아래는 이미
        Location 헤더를 고치는 아웃바운드 규칙이 **있는** 경우에만 해당한다.

        ! preConditions는 반드시 <outboundRules> **안**에 있어야 한다. <rewrite>
          바로 아래에 두면 스키마에 없는 요소라 설정 파싱이 통째로 실패하고,
          사이트 전체가 500.19가 된다 — 규칙이 하나도 안 돌아 "모든 경로가 막힘"
          으로 보인다. 아래 형태를 통째로 복사할 것(preCondition만 떼어 쓰지 말 것).

        <outboundRules>
          <rule name="fix-location" preCondition="not-loopback-location">
            ... 기존에 쓰던 Location 재작성 규칙 ...
          </rule>
          <preConditions>
            <preCondition name="not-loopback-location" logicalGrouping="MatchAll">
              <add input="{RESPONSE_Location}" pattern="^https?://127\.0\.0\.1" negate="true" />
            </preCondition>
          </preConditions>
        </outboundRules>
      -->
    </rewrite>

    <security>
      <requestFiltering>
        <!--
          git push는 IIS 기본 요청 크기 제한(30MB)에 걸린다 — 리포가 조금만
          커져도 413으로 끊긴다. 상한을 올려 둔다(값은 바이트, 여기선 4GB-1).
        -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
      <authentication>
        <!-- 인증은 Gitea·플랫폼이 직접 한다. IIS 단에서 걸면 이중으로 막힌다. -->
        <anonymousAuthentication enabled="true" />
        <windowsAuthentication enabled="false" />
        <basicAuthentication enabled="false" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
