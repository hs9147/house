; 이 플랫폼과 붙이는 데 필요한 Gitea 설정만 모은 예시.
;
; 적어 둔 값은 **서브패스 배포 + SSH 미사용** 구성 기준이다(플랫폼과 같은 도메인의
; /gitea 아래로 내보내고, git은 http로만 쓰는 경우). 다른 구성이라면 각 항목 주석에
; 적어 둔 대안으로 바꾼다.
;
; Gitea 전체 설정이 아니라 **연동에 관여하는 항목만** 담았다. 나머지는 Gitea 기본값과
; 설치 마법사가 채운 값을 그대로 두면 된다. 기존 app.ini가 있다면 아래 항목만 해당
; 섹션에 옮겨 적고 Gitea를 재시작한다(같은 섹션이 두 번 나오면 안 된다).
;
; 위치: Docker는 컨테이너 /data/gitea/conf/app.ini, 네이티브 Windows는
;       C:\gitea\custom\conf\app.ini (nssm AppDirectory 기준 custom/conf/app.ini).
;
; docker-compose를 쓴다면 이 파일 대신 compose의 GITEA__섹션__KEY 환경변수로 넣어도
; 결과는 같다(docker-compose.yml 참고). 환경변수 이름은 여기 섹션·키와 1:1로 대응한다 —
; 예: [server] ROOT_URL → GITEA__server__ROOT_URL.
;
; 아래 값들의 배경과 함께 봐야 할 절차는 README.md에 있다.

[server]
; 외부에서 실제로 접속하는 주소. **서브패스로 내보낸다면 그 경로까지 포함**해야 한다 —
; Gitea가 로그인 리다이렉트·정적 자산·OAuth 콜백 URL을 전부 이 값 기준으로 만들기
; 때문에, 경로가 빠지면 로그인 후 리다이렉트가 서브패스를 잃어버려 깨진다.
; 끝의 슬래시도 빼지 말 것.
ROOT_URL = https://paas.example.com/gitea/
; 호스트명만 적는다(경로 없이). ROOT_URL의 호스트와 같아야 한다.
DOMAIN = paas.example.com
;
; 리버스프록시는 이 접두어를 **벗기고** 넘겨야 한다 — Gitea는 모든 라우트를 "/"에
; 마운트하고 서브패스를 벗기지 않으므로, /gitea가 붙은 채로 오면 전부 404다. 이 값은
; Gitea가 **링크를 만들 때** 쓰는 접두어다. Caddy는 handle이 아니라 handle_path,
; IIS는 rewrite 타겟에 /gitea를 다시 붙이지 않기(README "서브패스" 절 참고).
; 반대로 USE_SUB_URL_PATH = true 로 두면 Gitea가 서브패스를 직접 처리한다(기본 false).
;
; 별도 도메인을 쓴다면 대신 이렇게 둔다:
;   ROOT_URL = https://git.example.com/
;   DOMAIN = git.example.com

; SSH 포트(22/2222)를 열 수 없는 환경이라 끈다. 플랫폼 동작에는 영향이 없다 —
; clone/fetch/push를 전부 http + 토큰 헤더로 하기 때문이다. 이 값을 켜야 Gitea UI가
; SSH clone 주소를 **감춘다**. 끄지 않으면 리포 화면에 쓸 수 없는 SSH 주소가 계속 함께
; 떠서, 사용자가 그걸 복사해 쓰다 연결이 안 돼 헤맨다.
DISABLE_SSH = true
; DISABLE_SSH = true 면 SSH_PORT는 의미가 없다. SSH를 쓰는 구성에서만 지정한다:
;   SSH_PORT = 2222

[service]
; 사내 전용 — 초대 없이 가입 금지(계정은 관리자가 만들거나 아래 SSO 자동 등록으로 생긴다).
; 이 값은 **로컬 가입 폼만** 막는다. 아래 oauth2_client 자동 등록에는 영향이 없다.
DISABLE_REGISTRATION = true

[oauth2]
; 개발자가 git push할 때 토큰을 손으로 만들지 않고 브라우저 로그인으로 끝내는 경로가
; 여기에 달려 있다. Gitea 1.21+는 아래 DEFAULT_APPLICATIONS의 앱들을 기동 시 미리
; 등록해 두므로, Git Credential Manager가 별도 서버 설정 없이 OAuth로 붙는다.
; 끄면 GCM이 OAuth를 못 찾아 비밀번호를 묻는 방식으로 되돌아간다.
ENABLED = true
DEFAULT_APPLICATIONS = git-credential-oauth, git-credential-manager, tea

[oauth2_client]
; SSO(플랫폼 계정)로 처음 들어오는 사람의 Gitea 계정을 관리자가 미리 만들어 두지
; 않아도 되게 한다. 위 DISABLE_REGISTRATION=true와 함께 써도 된다 — 그건 로컬 가입
; 폼만 막는다.
ENABLE_AUTO_REGISTRATION = true
; 플랫폼 계정과 같은 식별자를 쓰도록 이메일 기준으로 만든다.
USERNAME = email
; 같은 이메일의 기존 Gitea 계정이 있으면 새로 만들지 않고 SSO 로그인에 연결한다.
ACCOUNT_LINKING = auto

; ─────────────────────────────────────────────────────────────────────────────
; app.ini로 설정하지 않는 것들
;
; 1) SSO 인증 소스(플랫폼 OIDC 연동)는 app.ini가 아니라 DB에 저장된다. CLI로 등록한다:
;      gitea admin auth add-oauth --name paas --provider openidConnect \
;        --key gitea --secret "<시크릿>" \
;        --auto-discover-url "<플랫폼 discovery URL>/.well-known/openid-configuration"
;    (--name 값이 콜백 경로 /user/oauth2/<name>/callback에 그대로 들어간다 — 플랫폼의
;     PAAS_OIDC_PROVIDER_CLIENTS에 등록한 redirect_uris와 반드시 일치해야 한다.)
;
; 2) 플랫폼이 리포·조직을 자동 생성할 때 쓰는 API 토큰은 Gitea UI에서 발급해
;    플랫폼 .env의 PAAS_GITEA_API_TOKEN에 넣는다.
;
; 3) 웹훅은 플랫폼이 자동 등록한다(PAAS_PLATFORM_PUBLIC_URL 설정 시).
